local earthTransforms = asset.require("scene/solarsystem/planets/earth/transforms")
local eziemagDataDirectory = asset.resource("osfls_eziemag")

local EZIEMagVectors = {
    Identifier = "EZIEMag-Ground-Vectors",
    Parent = "Earth",

    Renderable = {
        Type = "RenderableFieldlinesSequence",
        SourceFolder = eziemagDataDirectory,
        InputFileType = "Osfls",
        ShowAtAllTimes = true,
        LineWidth = 3.0,

        ColorMethod = "By Quantity",
        ColorQuantity = 0,

        ColorTableRanges = { { 5.0, 3000.0 } },
        ColorMinMaxRange = { 0.0, 1000.0 },

        Color = { 0.0, 0.8, 0.9, 1.0 },

        ParticleSpacing = 12.0,
        ParticleSize = 10.0,
        FlowColor = { 0.2, 1.0, 0.8, 0.9 },
        FlowSpeed = 4.0,
        FlowEnabled = true,
        ReversedFlow = false
    },
    GUI = {
        Path = "/Earth/Magnetosphere",
        Name = "EZIE-Mag Magnetometer Network",
        Description = "3D perturbation vectors / equivalent ionospheric currents from EZIE-Mag stations."
    }
}

asset.onInitialize(function()
    openspace.addSceneGraphNode(EZIEMagVectors)
end)

asset.onDeinitialize(function()
    openspace.removeSceneGraphNode(EZIEMagVectors)
end)

asset.export(EZIEMagVectors)